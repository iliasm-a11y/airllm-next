+        result=measure_storage(cp,cfg,samples=3)
+        assert result['selected_io_workers'] in (1,2,4)
+        assert all(x['logical_bytes']>0 for x in result['candidates'])
+        assert (cfg.metadata_dir()/(cp.fingerprint+'.tuning.json')).is_file()
