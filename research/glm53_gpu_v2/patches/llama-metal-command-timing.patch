 #define MAX(a, b) ((a) > (b) ? (a) : (b))
+
+
+static void airllm_metal_commit(id<MTLCommandBuffer> command, const char * origin) {
+    const char * timing = getenv("AIRLLM_METAL_COMMAND_TIMING");
+    if (timing && strcmp(timing, "1") == 0) {
+        [command addCompletedHandler:^(id<MTLCommandBuffer> completed) {
+            const double start = completed.GPUStartTime;
+            const double end = completed.GPUEndTime;
+            fprintf(stderr, "AIRLLM_GPU_TIME origin=%s start=%.9f end=%.9f seconds=%.9f status=%lu\n",
+                    origin, start, end, end >= start ? end-start : -1.0,
+                    (unsigned long) completed.status);
+        }];
+    }
+    [command commit];
+}

