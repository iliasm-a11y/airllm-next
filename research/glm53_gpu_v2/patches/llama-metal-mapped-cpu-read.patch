     ggml_backend_buffer_type_t buft = NULL;
@@ -1460,5 +1555,8 @@
         }
     }

+    if (buf != NULL && airllm_metal_cpu_mapped_weight_supported(sched->backends[backend_id], t, buf)) {
+        return true;
+    }
     return buft != NULL && ggml_backend_supports_buft(sched->backends[backend_id], buft);
 }
