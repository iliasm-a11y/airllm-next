+#if defined(__APPLE__)
+static void ggml_cpu_prefetch_experts(const struct ggml_tensor * src0, const int64_t * counts, int n_experts) {
+    const char * enabled = getenv("AIRLLM_EXPERT_PREFETCH");
+    if (!enabled || strcmp(enabled, "1") != 0 || src0->type != GGML_TYPE_Q2_K ||
+            !src0->buffer || ggml_backend_buffer_get_usage(src0->buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS ||
+            !src0->data || !ggml_is_contiguous(src0) || src0->ne[3] != 1 || n_experts <= 0) {
+        return;
+    }
+    const long page_size_long = sysconf(_SC_PAGESIZE);
+    if (page_size_long <= 0) {
+        return;
+    }
+    const uintptr_t page_size = (uintptr_t) page_size_long;
+    const size_t stride = src0->nb[2];
+    if (stride == 0 || (size_t) n_experts > ggml_nbytes(src0)/stride) {
+        return;
+    }
+    for (int first = 0; first < n_experts;) {
+        if (counts[first] == 0) {
+            ++first;
+            continue;
+        }
+        int last = first + 1;
+        while (last < n_experts && counts[last] != 0) {
+            ++last;
+        }
+        const uintptr_t start = (uintptr_t) src0->data;
+        const size_t offset = (size_t) first*stride;
+        const size_t length = (size_t) (last - first)*stride;
+        if (offset > UINTPTR_MAX - start || length > UINTPTR_MAX - start - offset) {
+            return;
+        }
+        const uintptr_t address = start + offset;
+        const uintptr_t aligned = address - address%page_size;
+        const uintptr_t end = address + length;
+        const uintptr_t padding = (page_size - end%page_size)%page_size;
+        if (padding > UINTPTR_MAX - end) {
+            return;
+        }
+        (void) posix_madvise((void *) aligned, (size_t) (end + padding - aligned), POSIX_MADV_WILLNEED);
+        first = last;
+    }
+}
