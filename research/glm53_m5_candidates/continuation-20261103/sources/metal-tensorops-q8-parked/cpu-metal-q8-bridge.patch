+// Experimental CPU mul_mat provider. Build OFF and runtime OFF by default.
+// Source candidate only: this provider has not been compiled or executed.
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <IOKit/ps/IOPowerSources.h>
+#import <IOKit/ps/IOPSKeys.h>
+#include <mach/mach.h>
+#include <sys/sysctl.h>
+#include <unistd.h>
+#include <algorithm>
+#include <atomic>
+#include <cstdlib>
+#include <cmath>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <condition_variable>
+#include <string>
