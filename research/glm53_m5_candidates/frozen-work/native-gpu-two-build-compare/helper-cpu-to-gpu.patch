+// Full8/16/32/64/128 chunks stay unchanged. A short odd tail>8 becomes its
+// multiple-of8 prefix then its odd1/3/5/7 remainder, matching CPU8 parity.
+// An odd tail<=8 stays whole. This preserves eligibility, not actual nrc.
+static int prefill_take(int ub, int remaining) {
+    if ((ub != 8 && ub != 16 && ub != 32 && ub != 64 && ub != 128) || remaining <= 0)
+        throw std::runtime_error("candidate requires an admitted positive microbatch");
+    const int take = std::min(ub, remaining);
+    return remaining < ub && take > 8 && take % 2 != 0 ? take - take % 8 : take;
+}
