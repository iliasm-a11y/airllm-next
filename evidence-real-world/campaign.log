{"id": "B1", "text": "def dedoublonne(valeurs):\n    resultat = []\n    vus = []\n    for val in valeurs:\n        if isinstance(val, list):\n            cle = tuple(val)\n        else:\n            cle = val\n        if cle not in vus:\n            vus.append(cle)\n            resultat.append(val)\n    return resultat", "seconds": 130.58977729199978, "tokens": 78, "stop": "eos"}
